{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event Timetable Festival Configuration",
  "type": "object",
  "required": ["meta", "days", "stages", "events"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["festivalId", "festivalName", "timezone"],
      "properties": {
        "festivalId": { "type": "string", "maxLength": 80, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$" },
        "festivalName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "pageTitle": { "type": "string", "maxLength": 250 },
        "officialUrl": { "type": "string", "maxLength": 2048, "pattern": "^https?://" },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 100 },
        "themeColor": { "$ref": "#/$defs/color" },
        "venue": { "type": "string", "maxLength": 300 },
        "icon": { "type": "string", "maxLength": 16 }
      }
    },
    "days": {
      "type": "array", "minItems": 1, "maxItems": 366,
      "items": {
        "type": "object", "required": ["dayId", "label", "date", "timeRange"],
        "properties": {
          "dayId": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "timeRange": { "$ref": "#/$defs/range" }
        }
      }
    },
    "stages": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object", "required": ["id", "name", "color"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "shortName": { "type": "string", "maxLength": 100 },
          "subtitle": { "type": "string", "maxLength": 200 },
          "color": { "$ref": "#/$defs/color" }
        }
      }
    },
    "events": {
      "type": "array", "maxItems": 10000,
      "items": {
        "type": "object", "required": ["id", "dayId", "stageId", "name", "start", "end"],
        "properties": {
          "id": { "$ref": "#/$defs/id" }, "dayId": { "$ref": "#/$defs/id" }, "stageId": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 300 },
          "start": { "$ref": "#/$defs/time" }, "end": { "$ref": "#/$defs/time" },
          "description": {
            "type": "object",
            "properties": {
              "genre": { "type": "string", "maxLength": 500 }, "country": { "type": "string", "maxLength": 300 },
              "summary": { "type": "string", "maxLength": 10000 }, "highlight": { "type": "string", "maxLength": 2000 },
              "isAIGenerated": { "type": "boolean" }
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "memberColors": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/$defs/color" } },
        "memberAvatars": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 16 } },
        "timeBands": {
          "type": "array", "maxItems": 100,
          "items": {
            "type": "object", "required": ["label", "start", "end"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 200 }, "dayId": { "$ref": "#/$defs/id" },
              "start": { "$ref": "#/$defs/time" }, "end": { "$ref": "#/$defs/time" }, "color": { "$ref": "#/$defs/color" }
            }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "legacyStorageKeys": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "acceptLegacyShare": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "range": { "type": "object", "required": ["start", "end"], "properties": { "start": { "$ref": "#/$defs/time" }, "end": { "$ref": "#/$defs/time" } } }
  }
}
